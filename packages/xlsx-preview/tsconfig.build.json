{
  // Declaration-only build for publishing. Source files only — no tests
  // (they import from `../dist`, which would pull dist d.ts files in as inputs
  // and trip TS5055).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "dist"]
}
